# Amanita Ocean landing page.
ocean.amanita.music {
	root * /var/www/ocean.amanita.music/current
	file_server
	encode gzip zstd

	@index path /index.html
	redir @index / 308

	@fresh path / /index.html /styles.css /js/* /robots.txt /sitemap.xml
	header @fresh Cache-Control "no-cache"

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=604800"

	@downloads path /downloads/*
	header @downloads Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	log {
		output file /var/log/caddy/ocean.log {
			roll_size 50MiB
			roll_keep 10
		}
	}
}
